{
  "name": "melinna-desk",
  "productName": "Melinna",
  "version": "0.1.0",
  "description": "Workspace desktop local-first para rodar vários agentes de CLI em paralelo, cada um num PTY isolado no seu próprio git worktree.",
  "private": true,
  "main": "out/main/main.js",
  "author": "Davii-code",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/vitest-electron-node.mjs run --project integration",
    "test:perf": "node scripts/vitest-electron-node.mjs run --project perf",
    "test:arch": "vitest run --project arch",
    "test:e2e": "electron-vite build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "electron scripts/render-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "postinstall": "node scripts/ensure-node-pty.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
